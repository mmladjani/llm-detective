# Secrets — never commit real keys
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# OS junk
.DS_Store

# Local assistant settings and worktrees, not release source
.claude/

# Run artifacts (regenerated by eval/*.py) — keep the folder, not its contents
outputs/*
!outputs/.gitkeep

# Generated cases (reproducible via `python eval/generate_cases.py`)
cases/generated/

# Terminal run logs
*.log

# Scratch image folders (kept on disk, never committed)
_r/
_s/
_t/
_u/
